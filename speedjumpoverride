-- CONFIG
local TARGET_WALKSPEED = 16
local TARGET_JUMPPOWER = 50

local lastDeathPosition = nil
local isTeleporting = false
local enabled = true -- default ON

local player = game:GetService("Players").LocalPlayer
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

----------------------------------------------------------------
-- CHARACTER LOGIC (speed/jump + teleport on death)
----------------------------------------------------------------

local function onCharacterAdded(character)
    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")

    humanoid.UseJumpPower = true

    if lastDeathPosition and isTeleporting then
        task.wait(0.1)
        rootPart.CFrame = CFrame.new(lastDeathPosition)
        isTeleporting = false
    end

    humanoid.Died:Connect(function()
        if rootPart then
            lastDeathPosition = rootPart.Position
            isTeleporting = true
        end
    end)

    local connection1
    local connection2

    connection1 = RunService.Heartbeat:Connect(function()
        if not character:IsDescendantOf(game) or humanoid.Health <= 0 then
            connection1:Disconnect()
            return
        end

        if enabled then
            humanoid.WalkSpeed = TARGET_WALKSPEED
            humanoid.JumpPower = TARGET_JUMPPOWER
        end
    end)

    connection2 = RunService.PreSimulation:Connect(function()
        if not character:IsDescendantOf(game) or humanoid.Health <= 0 then
            connection2:Disconnect()
            return
        end

        if enabled then
            humanoid.WalkSpeed = TARGET_WALKSPEED
            humanoid.JumpPower = TARGET_JUMPPOWER
        end
    end)
end

if player.Character then
    task.spawn(onCharacterAdded, player.Character)
end
player.CharacterAdded:Connect(onCharacterAdded)

if player.Character and player.Character:FindFirstChild("Humanoid") then
    player.Character.Humanoid.Health = 0
end

